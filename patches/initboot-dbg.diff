 #include <modprobe/modprobe.h>
 #include <private/android_filesystem_config.h>
 
@@ -416,6 +421,88 @@ int FirstStageMain(int argc, char** argv) {
     setenv(kEnvFirstStageStartedAt, std::to_string(start_time.time_since_epoch().count()).c_str(),
            1);
 
+    // ---- DBG-BOOT v7（测试用）: N 秒后 —— 抄 属性/网卡/模块表/内核日志 → 写 BCB 重启 ----
+    // v6 已验证：这一套（含写 BCB）能让设备到点自己回 fastboot，dump 落 /metadata/dbg-kernel.log。
+    // v6 两条教训：① /dev/kmsg 读不到历史消息，必须 syslog(2) READ_ALL；
+    //   ② KSU 那个 insmod 是纯噪声（GKI 不导出符号，纯 finit_module 装不上，需 ksud 做符号
+    //      重定位），已移除——免得上百行 Unknown symbol 把 ring buffer 冲掉、看不见厂商日志。
+    // v7 新增：属性快照（尤其 vendor.connsys.driver.ready —— 厂商 wlan rc 的触发条件）
+    //   和网络接口列表（判断驱动装上后 wlan0 到底出现没有）。
+    if (fork() == 0) {
+        sleep(120);
+
+        // (1) 复测厂商 wlan 驱动：v6 实测它没被装进内核（WiFi 打不开的直接原因）
+        int wlan_rc = -1, wlan_err = 0;
+        int wlan_fd = open("/vendor/lib/modules/wlan_drv_gen4m_6835.ko", O_RDONLY | O_CLOEXEC);
+        if (wlan_fd < 0) {
+            wlan_err = errno;
+        } else {
+            wlan_rc = syscall(__NR_finit_module, wlan_fd, "", 0);
+            wlan_err = errno;
+            close(wlan_fd);
+        }
+
+        // (2) 面包屑 + 等内核把详细理由打进 ring buffer（下一步要读它）
+        int kmsg_fd = open("/dev/kmsg", O_WRONLY | O_CLOEXEC);
+        if (kmsg_fd >= 0) {
+            std::string m = "DBG-BOOT v7: wlan rc=" + std::to_string(wlan_rc) +
+                            " errno=" + std::to_string(wlan_err) + "\n";
+            (void)write(kmsg_fd, m.c_str(), m.size());
+            close(kmsg_fd);
+        }
+        sleep(3);
+
+        // (3) 结论 + 属性 + 内核 ring buffer + cmdline + 模块表 + 网卡 → /metadata/dbg-kernel.log
+        //     结论放最前面：v5 就是日志读法错了白跑一轮，rc/errno 必须先落地。
+        std::string dump = "===== insmod results =====\n";
+        dump += "wlan_drv_gen4m_6835.ko rc=" + std::to_string(wlan_rc) +
+                " errno=" + std::to_string(wlan_err) + "\n";
+
+        dump += "\n===== properties =====\n";
+        for (const char* p : {"vendor.connsys.driver.ready", "ro.vendor.wlan.chrdev",
+                              "ro.vendor.wlan.gen", "sys.boot_completed",
+                              "init.svc.wlan_assistant", "init.svc.wmt_loader",
+                              "init.svc.wpa_supplicant", "vold.decrypt"}) {
+            dump += std::string(p) + " = [" + android::base::GetProperty(p, "<unset>") + "]\n";
+        }
+
+        {
+            static char kbuf[512 * 1024];  // 只在子进程里碰，不占第一阶段常驻内存
+            long n = syscall(__NR_syslog, 3 /* SYSLOG_ACTION_READ_ALL */, kbuf, sizeof(kbuf) - 1);
+            dump += "\n===== kernel ring buffer (syslog READ_ALL) =====\n";
+            if (n > 0) {
+                dump.append(kbuf, n);
+            } else {
+                dump += "syslog rc=" + std::to_string(n) + " errno=" + std::to_string(errno) + "\n";
+            }
+        }
+        for (const char* f : {"/proc/cmdline", "/proc/modules", "/proc/net/dev"}) {
+            dump += std::string("\n===== ") + f + " =====\n";
+            int fd = open(f, O_RDONLY | O_CLOEXEC);
+            if (fd < 0) {
+                dump += "open failed errno=" + std::to_string(errno) + "\n";
+                continue;
+            }
+            char buf[16384];
+            ssize_t n;
+            while ((n = read(fd, buf, sizeof(buf))) > 0) dump.append(buf, n);
+            close(fd);
+        }
+        if (!android::base::WriteStringToFile(dump, "/metadata/dbg-kernel.log")) {
+            LOG(WARNING) << "DBG-BOOT: 写 /metadata/dbg-kernel.log 失败";
+        }
+
+        sync();
+        std::string err;
+        if (!write_reboot_bootloader(&err)) {
+            LOG(WARNING) << "DBG-BOOT: write_reboot_bootloader failed: " << err;
+        }
+        syscall(__NR_reboot, LINUX_REBOOT_MAGIC1, LINUX_REBOOT_MAGIC2, LINUX_REBOOT_CMD_RESTART2,
+                "bootloader");
+        _exit(0);
+    }
+    // ---- /DBG-BOOT ----
+
     const char* path = "/system/bin/init";
     const char* args[] = {path, "selinux_setup", nullptr};
     auto fd = open("/dev/kmsg", O_WRONLY | O_CLOEXEC);
